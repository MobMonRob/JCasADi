/*
 * full_simplify.mac
 *
 * First draft of an automatic "FullSimplify"-like procedure for:
 *   - polynomials
 *   - rational expressions
 *   - trigonometric expressions
 *
 * Objective for now:
 *   Minimize Maxima's internal expression size (conssize).
 *
 * Design:
 *   1. Cheap transformations until no improvement.
 *   2. Try several more expensive / temporarily expanding macros.
 *   3. If one improves the expression, return to the cheap stage.
 *   4. Stop after a bounded number of rounds.
 */


/* Expose Maxima's internal size measure. */
:lisp (defmfun $fs_size (x) (conssize x))


/*
 * Safely apply a transformation.
 *
 * If a Maxima transformation throws an error for an expression,
 * just treat that transformation as "no improvement".
 */
fs_apply(f, e) :=
    block([r],
        r : errcatch(apply(f, [e])),
        if r = []
        then e
        else first(r)
    )$


/*
 * Return the smallest expression according to fs_size().
 *
 * Ties deliberately keep the earlier expression.
 * This avoids pointless representation changes and oscillation.
 */
fs_best(candidates) :=
    block([best, best_size, candidate, candidate_size, i],

        best      : first(candidates),
        best_size : fs_size(best),

        for i : 2 thru length(candidates) do (
            candidate      : candidates[i],
            candidate_size : fs_size(candidate),

            if candidate_size < best_size then (
                best      : candidate,
                best_size : candidate_size
            )
        ),

        best
    )$


/*
 * Cheap transformations.
 *
 * These should be reasonable to try repeatedly.
 */
fs_core_step(e) :=
    block([t, r, rt, tr, rtr, xr],

        /* Fundamental trig identities. */
        t : fs_apply(
                lambda([x], trigsimp(x)),
                e
            ),

        /* Polynomial / rational canonical simplification. */
        r : fs_apply(
                lambda([x], ratsimp(x)),
                e
            ),

        /*
         * Trig first, rational algebra second.
         * Explicitly recommended as a useful continuation of trigsimp.
         */
        rt : fs_apply(
                 lambda([x], ratsimp(x)),
                 t
             ),

        /*
         * Reverse direction as a competing candidate:
         * rational normalization may expose trig identities.
         */
        tr : fs_apply(
                 lambda([x], trigsimp(x)),
                 r
             ),

        /*
         * Allow one additional rational cleanup after that.
         * The intermediate tr need not itself be smaller.
         */
        rtr : fs_apply(
                  lambda([x], ratsimp(x)),
                  tr
              ),

        /*
         * Documented useful ordering:
         * xthru can cancel explicit factors before ratsimp expands them.
         */
        xr : fs_apply(
                 lambda([x], ratsimp(xthru(x))),
                 e
             ),

        fs_best([e, t, r, rt, tr, rtr, xr])
    )$


/*
 * Repeat cheap transformations, but keep runtime bounded.
 */
fs_core(e, max_rounds) :=
    block([current, next, i],

        current : e,

        for i : 1 thru max_rounds do (
            next : fs_core_step(current),

            if fs_size(next) < fs_size(current)
            then current : next
            else return(current)
        ),

        current
    )$


/*
 * Angle sum/difference expansion.
 *
 * Deliberately:
 *   trigexpandplus  = true
 *   trigexpandtimes = false
 *
 * Thus sin(x+y) may be expanded, while sin(2*x) is not expanded
 * merely because it contains a multiple.
 *
 * Most importantly, the EXPANDED INTERMEDIATE RESULT is never
 * compared against e.  Only the result after subsequent trig/rational
 * simplification is compared.
 */
fs_angle_expand(e) :=
    block(
        [trigexpandplus : true,
         trigexpandtimes : false],

        ratsimp(
            trigsimp(
                trigexpand(e)
            )
        )
    )$


/*
 * More expensive / more aggressive alternatives.
 *
 * These are not repeatedly executed as part of the cheap fixed point.
 */
fs_deep_step(e) :=
    block([fr, red, expd, fac, trat],

        /*
         * Repeated rational/non-rational interaction.
         */
        fr : fs_apply(
                 lambda([x],
                     fullratsimp(trigsimp(x))
                 ),
                 e
             ),

        /*
         * Products/powers of trig functions -> multiple-angle form,
         * followed by cleanup.
         */
        red : fs_apply(
                  lambda([x],
                      ratsimp(
                          trigsimp(
                              trigreduce(
                                  trigsimp(x)
                              )
                          )
                      )
                  ),
                  e
              ),

        /*
         * Angle-sum expansion can temporarily grow enormously,
         * so treat the whole chain as ONE candidate.
         */
        expd : fs_apply(
                   lambda([x], fs_angle_expand(x)),
                   e
               ),

        /*
         * Factor only after rational simplification.
         */
        fac : fs_apply(
                  lambda([x],
                      factor(ratsimp(x))
                  ),
                  e
              ),

        /*
         * Specialized rational-trigonometric canonicalizer.
         * Put ordinary trig/rational simplification before it,
         * then one rational cleanup afterwards.
         */
        trat : fs_apply(
                   lambda([x],
                       ratsimp(
                           trigrat(
                               trigsimp(
                                   ratsimp(x)
                               )
                           )
                       )
                   ),
                   e
               ),

        fs_best([e, fr, red, expd, fac, trat])
    )$


/*
 * Main entry point.
 *
 * Default effort:
 *   - at most 6 cheap improvement rounds
 *   - at most 2 deep rounds
 *
 * Every accepted transition strictly lowers conssize.
 */
full_simplify(e) :=
    block([current, deep, i],

        current : fs_core(e, 6),

        for i : 1 thru 2 do (
            deep : fs_deep_step(current),

            if fs_size(deep) < fs_size(current)
            then (
                /*
                 * A deep transformation may expose ordinary
                 * simplifications, so return to the cheap fixed point.
                 */
                current : fs_core(deep, 6)
            )
            else return(current)
        ),

        current
    )$


/* Even cheaper variant for initial benchmarking. */
full_simplify_fast(e) :=
    fs_core(e, 6)$
